# ================================================================================
# VARIABLES DE ENTORNO - OperacionesRanger Backend
# ================================================================================
#
# Este archivo contiene todas las variables de entorno necesarias para el backend
# del Sistema de Gestión de Turnos de OperacionesRanger.
#
# INSTRUCCIONES DE USO:
# 1. Copia este archivo a .env en el mismo directorio:
#    cp .env.example .env
#
# 2. Edita .env y reemplaza los valores de ejemplo con tus credenciales reales
#
# 3. NUNCA comitees el archivo .env al repositorio (está en .gitignore)
#
# 4. En producción, configura estas variables en tu servidor/plataforma de hosting
#
# ================================================================================

# ================================================================================
# SERVIDOR
# ================================================================================

# Ambiente de ejecución del servidor
# Valores válidos: development | production | test
# - development: Habilita hot-reload, logging detallado, mensajes de error completos
# - production: Optimizaciones, logging reducido, manejo de errores seguro
# - test: Configuración para pruebas automatizadas
# Por defecto: development
NODE_ENV=development

# Puerto en el que escucha el servidor HTTP
# Valores válidos: 1024-65535 (usar > 1024 para evitar requerir permisos root)
# Común: 3000, 3333, 8000, 8080
# Por defecto: 3000
PORT=3000

# Nivel de logging del servidor
# Valores válidos: error | warn | info | debug
# - error: Solo errores críticos
# - warn: Errores y advertencias
# - info: Errores, advertencias e información general (RECOMENDADO para producción)
# - debug: Todos los niveles incluyendo detalles de debugging (RECOMENDADO para desarrollo)
# Por defecto: info
LOG_LEVEL=debug

# Ruta donde se almacenan los archivos de logs
# Puede ser ruta absoluta o relativa al directorio backend/
# Los logs se rotan diariamente con nombres como:
# - combined-YYYY-MM-DD.log (todos los logs)
# - error-YYYY-MM-DD.log (solo errores)
# Valores comunes:
# - logs (relativo, crea carpeta logs/ en backend/) - RECOMENDADO
# - /var/log/operaciones-ranger (absoluto, típico en servidores Linux)
# Por defecto: logs
LOG_FILE_PATH=logs

# ================================================================================
# BASE DE DATOS PRINCIPAL - TURNOS GUARDIANES
# ================================================================================
#
# Base de datos principal del sistema (turnos_guardianes)
# Permisos requeridos: SELECT, INSERT, UPDATE, DELETE, EXECUTE (stored procedures)
# Esta BD almacena: clientes, ubicaciones, puestos, turnos, incentivos, feriados
#

# Host del servidor MySQL donde está la base de datos de turnos
# Valores comunes:
# - localhost o 127.0.0.1 para desarrollo local
# - IP o dominio del servidor MySQL en producción
# REQUERIDO
DB_TURNOS_HOST=localhost

# Puerto del servidor MySQL
# Valor estándar: 3306
# Cambiar solo si MySQL está configurado en puerto no estándar
# REQUERIDO
DB_TURNOS_PORT=3306

# Nombre de la base de datos de turnos
# Valor esperado: turnos_guardianes (creada en setup inicial)
# REQUERIDO
DB_TURNOS_NAME=turnos_guardianes

# Usuario de MySQL con permisos de lectura/escritura en turnos_guardianes
# En producción: crear usuario específico con permisos mínimos necesarios
# En desarrollo: puede ser root (NO recomendado para producción)
# REQUERIDO
DB_TURNOS_USER=root

# Contraseña del usuario de MySQL para base de datos de turnos
# IMPORTANTE: Usar contraseña fuerte en producción (mín. 12 caracteres)
# NO usar contraseñas de ejemplo o por defecto
# REQUERIDO
DB_TURNOS_PASSWORD=your_secure_password_here

# ================================================================================
# BASE DE DATOS RRHH - SISTEMA DE RECURSOS HUMANOS (READ-ONLY)
# ================================================================================
#
# Base de datos del sistema de RRHH existente (db_aae4a2_ranger)
# Permisos requeridos: SELECT únicamente (solo lectura)
# Esta BD provee: información de empleados (guardianes de seguridad)
# Filtro de guardianes: WHERE id_puesto = 97 AND status = 1
#

# Host del servidor MySQL donde está la base de datos de RRHH
# Puede ser el mismo servidor que DB_TURNOS_HOST o servidor diferente
# REQUERIDO
DB_RRHH_HOST=localhost

# Puerto del servidor MySQL para base de datos RRHH
# Valor estándar: 3306
# REQUERIDO
DB_RRHH_PORT=3306

# Nombre de la base de datos de RRHH
# Valor esperado: db_aae4a2_ranger (sistema existente)
# REQUERIDO
DB_RRHH_NAME=db_aae4a2_ranger

# Usuario de MySQL con permisos de SOLO LECTURA en db_aae4a2_ranger
# IMPORTANTE: Este usuario debe tener permisos de SELECT únicamente
# En producción: crear usuario read-only específico
# Comando ejemplo:
#   CREATE USER 'turnos_readonly'@'localhost' IDENTIFIED BY 'password';
#   GRANT SELECT ON db_aae4a2_ranger.rh_empleado TO 'turnos_readonly'@'localhost';
#   FLUSH PRIVILEGES;
# REQUERIDO
DB_RRHH_USER=root

# Contraseña del usuario de MySQL para base de datos RRHH
# REQUERIDO
DB_RRHH_PASSWORD=your_secure_password_here

# ================================================================================
# SEGURIDAD - AUTENTICACIÓN JWT
# ================================================================================
#
# Configuración de JSON Web Tokens para autenticación de usuarios
# REQUERIDAS en Fase 2 (implementación de autenticación)
#

# Secreto para firmar y verificar ACCESS TOKENS (corta duración)
# REQUISITOS:
# - Mínimo 32 caracteres (recomendado: 64)
# - Cadena aleatoria criptográficamente segura
# - NUNCA usar el valor de ejemplo en producción
# - Cambiar este valor invalida todos los access tokens
# Generar secreto seguro:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUERIDO en Fase 2
JWT_SECRET=your_jwt_access_secret_key_minimum_32_characters_random_string_here

# Tiempo de expiración de ACCESS TOKENS (corta duración para seguridad)
# Formato: número + unidad (s=segundos, m=minutos, h=horas, d=días)
# Valores recomendados:
# - 15m: Tokens expiran en 15 minutos (RECOMENDADO - alta seguridad)
# - 30m: Tokens expiran en 30 minutos (balance seguridad/usabilidad)
# - 1h: Tokens expiran en 1 hora (máxima usabilidad, menor seguridad)
# REQUERIDO en Fase 2
JWT_ACCESS_EXPIRES_IN=15m

# Secreto para firmar y verificar REFRESH TOKENS (larga duración)
# REQUISITOS:
# - Debe ser DIFERENTE de JWT_SECRET
# - Mínimo 32 caracteres (recomendado: 64)
# - Cadena aleatoria criptográficamente segura
# - Cambiar este valor invalida todos los refresh tokens
# Generar secreto seguro:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUERIDO en Fase 2
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_random_string_different_from_access

# Tiempo de expiración de REFRESH TOKENS (larga duración)
# Formato: número + unidad (s=segundos, m=minutos, h=horas, d=días)
# Valores recomendados:
# - 7d: Tokens expiran en 7 días (RECOMENDADO - balance seguridad/usabilidad)
# - 14d: Tokens expiran en 14 días (mayor usabilidad)
# - 30d: Tokens expiran en 30 días (máxima usabilidad, menor seguridad)
# REQUERIDO en Fase 2
JWT_REFRESH_EXPIRES_IN=7d

# Rounds de bcrypt para hashing de contraseñas
# Valores válidos: 4-31 (cada incremento duplica el tiempo de procesamiento)
# Valores comunes:
# - 10: Balance óptimo seguridad/performance (RECOMENDADO)
# - 12: Mayor seguridad, procesamiento más lento
# - 8: Desarrollo/testing (NO usar en producción)
# Por defecto: 10
BCRYPT_ROUNDS=10

# ================================================================================
# CORS - CROSS-ORIGIN RESOURCE SHARING
# ================================================================================

# Origen (URL) del frontend permitido para hacer peticiones al backend
# El navegador bloqueará peticiones de otros orígenes
# Valores comunes:
# - http://localhost:4200 (desarrollo Angular en puerto por defecto)
# - http://localhost:3001 (si frontend usa otro puerto)
# - https://tudominio.com (producción)
# Múltiples orígenes: separar con comas (requiere código adicional)
# Por defecto: http://localhost:4200
CORS_ORIGIN=http://localhost:4200

# ================================================================================
# LOCALIZACIÓN
# ================================================================================

# Zona horaria del sistema
# Usado para timestamps, cálculos de fechas, y logs
# Valor para República Dominicana: America/Santo_Domingo
# Otras zonas: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# IMPORTANTE: Debe coincidir con la zona horaria de la base de datos
# Por defecto: America/Santo_Domingo
TZ=America/Santo_Domingo

# ================================================================================
# CACHÉ EN MEMORIA
# ================================================================================
#
# Configuración del sistema de caché en memoria (node-cache)
# El caché reduce las consultas a la base de datos RRHH almacenando temporalmente
# datos de guardianes activos en memoria.
#

# Habilitar o deshabilitar el sistema de caché
# Valores válidos: true | false
# - true: Caché habilitado (RECOMENDADO para producción y desarrollo)
# - false: Caché deshabilitado (solo para debugging o troubleshooting)
# Por defecto: true
CACHE_ENABLED=true

# Tiempo de vida (TTL) del caché en segundos
# Tiempo que los datos permanecen en caché antes de expirar automáticamente
# Valores recomendados:
# - 300 (5 minutos): Balance óptimo entre performance y actualidad de datos (RECOMENDADO)
# - 600 (10 minutos): Mayor reducción de queries, datos menos actuales
# - 60 (1 minuto): Datos más actuales, menos reducción de queries
# Por defecto: 300
CACHE_TTL_SECONDS=300

# ================================================================================
# AUDITORÍA DE OPERACIONES
# ================================================================================
#
# Sistema de auditoría que registra todas las operaciones CRUD en la tabla
# sys_auditoria para trazabilidad y cumplimiento.
#

# Habilitar o deshabilitar el sistema de auditoría
# Valores válidos: true | false
# - true: Auditoría habilitada, todas las operaciones CREATE/UPDATE/DELETE se registran (RECOMENDADO)
# - false: Auditoría deshabilitada (solo para testing o debugging)
# IMPORTANTE: En producción, mantener en true para cumplimiento y trazabilidad
# Por defecto: true
AUDIT_ENABLED=true

# ================================================================================
# NOTAS ADICIONALES
# ================================================================================
#
# SEGURIDAD:
# - NO compartas el archivo .env con nadie
# - NO comitees .env al repositorio
# - Usa contraseñas fuertes y únicas para cada ambiente
# - Rota credenciales periódicamente
# - En producción, considera usar gestores de secretos (AWS Secrets Manager, etc.)
#
# TROUBLESHOOTING:
# - Si el servidor no arranca, verifica que todas las variables REQUERIDAS estén configuradas
# - Los mensajes de error indicarán qué variable falta
# - Verifica que las credenciales de BD sean correctas probando conexión manual:
#   mysql -h DB_TURNOS_HOST -P DB_TURNOS_PORT -u DB_TURNOS_USER -p
#
# DOCUMENTACIÓN:
# - Ver CLAUDE.md para contexto completo del proyecto
# - Ver docs/completed/T009_variables_entorno.md para documentación detallada
# - Ver backend/README.md para guía de instalación
#
# ================================================================================

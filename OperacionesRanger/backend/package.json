{
  "name": "operaciones-ranger-backend",
  "version": "1.0.0",
  "description": "Backend del Sistema de Gestión de Turnos para Guardianes de Seguridad - Guardianes Ranger",
  "main": "dist/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register --project tsconfig.dev.json src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern='(services|middlewares|unit|utils)' --testPathIgnorePatterns='integration'",
    "test:integration": "jest --testPathPattern='integration'",
    "test:integration:auth": "jest --testPathPattern='integration/auth'",
    "test:integration:crud": "jest --testPathPattern='integration/(clientes|ubicaciones|puestos|feriados|config-turnos|incentivos)'",
    "test:integration:rrhh": "jest --testPathPattern='integration/rrhh'",
    "test:integration:turnos": "jest --testPathPattern='integration/turnos'",
    "test:integration:reportes": "jest --testPathPattern='integration/reportes'",
    "test:coverage:integration": "jest --coverage --testPathPattern='integration'",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:password": "jest password.service.test.ts",
    "test:jwt": "jest jwt.service.test.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:init": "ts-node scripts/init-db.ts",
    "db:test": "ts-node scripts/test-connection.ts",
    "db:seed": "ts-node scripts/seed-feriados.ts",
    "db:seed:usuarios": "ts-node scripts/seed-usuarios.ts",
    "db:seed:maestros": "ts-node scripts/seed-maestros.ts",
    "db:examples": "ts-node scripts/query-examples.ts",
    "db:reset": "ts-node scripts/reset-test-data.ts"
  },
  "keywords": [
    "turnos",
    "guardianes",
    "seguridad",
    "typescript",
    "express",
    "mysql"
  ],
  "author": "Guardianes Ranger",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.6.5",
    "node-cache": "^5.1.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tslib": "^2.8.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.5",
    "@types/node-cache": "^4.1.3",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
